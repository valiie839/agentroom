# Copia este archivo a .env.local y rellena los valores.
#   cp .env.example .env.local

# Portal — https://app.useportal.co (Settings -> Api Keys)
NEXT_PUBLIC_PORTAL_PUBLISHABLE_KEY=pk_xxxxxxxxxxxx
PORTAL_SECRET_KEY=sk_xxxxxxxxxxxx

# Proveedor de IA: groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
