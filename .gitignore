# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# herramientas con las que se grabo el video de la entrega: utiles para
# reproducirlo, pero no forman parte del producto
demo/

# los regenera `next dev` en cada arranque; son instrucciones para
# asistentes de IA, no codigo del proyecto
AGENTS.md
CLAUDE.md

# configuracion de herramientas de desarrollo, no del proyecto
.claude/

# el video de la entrega vive en YouTube, no en el repositorio
*.mp4
